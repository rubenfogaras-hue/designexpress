# ── Supabase ───────────────────────────────────────────────────────────
# From your project's Settings → API page. Server-only: used to write orders
# and generate signed photo-upload URLs.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key

# Same URL, plus the public "anon" key — safe to expose in the browser.
# Used so a customer's photos can upload directly to Supabase Storage.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_your_anon_public_key

# ── Stripe webhook ─────────────────────────────────────────────────────
# Signing secret for the /api/stripe-webhook endpoint. Create the webhook in
# Stripe → Developers → Webhooks (event: checkout.session.completed), then
# copy its "Signing secret" (starts with whsec_) here. No Stripe API key is
# needed — the endpoint verifies signatures itself.
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_signing_secret

# ── Email (Titan via GoDaddy) ──────────────────────────────────────────
# Sends the post-payment confirmation from info@rubenhorizontvisual.com.
# The mailbox is Titan resold by GoDaddy, so the host is smtpout.secureserver.net.
# smtp.titan.email does NOT work — it answers AccountNotFound for this address.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=587
SMTP_USER=info@rubenhorizontvisual.com
SMTP_PASSWORD=replace_with_the_mailbox_password
