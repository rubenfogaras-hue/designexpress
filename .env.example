# ── Stripe ──────────────────────────────────────────────────────────────
# Secret key (server-side only). Get it from https://dashboard.stripe.com/apikeys
# Use a test key (sk_test_…) while developing.
STRIPE_SECRET_KEY=replace_with_your_stripe_secret_key

# ── App ─────────────────────────────────────────────────────────────────
# Public base URL used to build Stripe success / cancel redirect URLs.
# In production set this to your real domain, e.g. https://horizontvisuals.ro
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# The Stripe Price id to charge (from your Product in the dashboard, looks like price_...).
# If set, this is used and DESIGN_EXPRESS_PRICE_CENTS is ignored.
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx

# Fallback price if STRIPE_PRICE_ID is empty, in EUR cents (49 € = 4900).
DESIGN_EXPRESS_PRICE_CENTS=4900
